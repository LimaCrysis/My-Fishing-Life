{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfl.local/schemas/evaluation-collection-v1.json",
  "schemaVersion": "1.0.0",
  "storage": {
    "snapshotsKey": "mfl_evaluation_forecast_snapshots_v1",
    "appendOnly": true,
    "automaticDeletion": false,
    "externalTransmission": false
  },
  "tripExtension": {
    "fields": ["spotId", "startTimestamp", "endTimestamp", "timezone", "evaluationSchemaVersion", "targetSpeciesIds", "targetSpeciesHistory", "effortMinutes", "effortQuality", "forecastSnapshotStatus"]
  },
  "catchExtension": {
    "fields": ["spotId", "speciesId", "catchTimestamp", "catchTimeQuality", "timezone", "evaluationSchemaVersion", "recordedAt"]
  },
  "snapshot": {
    "compact": true,
    "required": ["tripId", "captureMode", "capturedAt", "targetDate", "spotId", "speciesId", "hour", "currentRaw", "currentStage", "cmRaw", "cmStage", "presence", "reliability", "fallback", "safety", "inputIdentifiers", "immutableHash"]
  },
  "quality": {
    "minimumNegativeEffortMinutes": 60,
    "maximumCompleteEffortHours": 18,
    "timeQuality": ["exact", "approximate", "unknown"],
    "incompleteTripIsNegative": false
  }
}
